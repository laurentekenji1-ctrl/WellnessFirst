@page "/staff/action-plans"
@attribute [Authorize(Policy = "StaffActionPlansManage")]
@using System.ComponentModel.DataAnnotations
@using WellnessPlatform.Models
@inject CurrentUserService CurrentUser
@inject WellnessService Wellness

<PageTitle>Staff Action Plans | Wellness Platform</PageTitle>

<div class="client-dashboard staff-dashboard">
    <section class="dashboard-hero">
        <div class="dashboard-hero-content">
            <div class="dashboard-eyebrow">MY WORK</div>
            <h1>Action Plans</h1>
            <p>Create plans for clients assigned to you and track completion.</p>
        </div>
        <div class="dashboard-hero-action">
            <span class="staff-role-badge">@actionPlans.Count(plan => plan.Status == ActionPlanStatus.Active) active plans</span>
        </div>
    </section>

    <section class="dashboard-panel action-plan-form-panel">
        <div class="panel-header">
            <div>
                <span class="panel-eyebrow">NEW PLAN</span>
                <h2>Create an action plan</h2>
                <p>Only clients with appointments assigned to you are available.</p>
            </div>
        </div>

        @if (clients.Count == 0)
        {
            <div class="empty-state">
                <h3>No assigned clients</h3>
                <p>Assign an appointment to you before creating a client action plan.</p>
            </div>
        }
        else
        {
            <EditForm Model="newPlan" OnValidSubmit="CreateActionPlanAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="action-plan-form">
                    <label class="form-group">
                        <span>Client</span>
                        <InputSelect class="form-control" @bind-Value="newPlan.ClientId">
                            <option value="0">Choose an assigned client</option>
                            @foreach (var client in clients)
                            {
                                <option value="@client.Id">@client.FullName</option>
                            }
                        </InputSelect>
                    </label>
                    <label class="form-group">
                        <span>Title</span>
                        <InputText class="form-control"
                                   maxlength="160"
                                   @bind-Value="newPlan.Title" />
                        <ValidationMessage For="@(() => newPlan.Title)" />
                    </label>
                    <label class="form-group action-plan-description">
                        <span>Description</span>
                        <InputTextArea class="form-control"
                                       maxlength="2000"
                                       rows="4"
                                       @bind-Value="newPlan.Description" />
                        <ValidationMessage For="@(() => newPlan.Description)" />
                    </label>
                    <label class="form-group">
                        <span>Target date (optional)</span>
                        <InputDate class="form-control"
                                   @bind-Value="newPlan.TargetDate" />
                    </label>
                    <button class="button button-primary" type="submit">
                        Create plan
                    </button>
                </div>
            </EditForm>
        }

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <p class="notification-status" role="status">@statusMessage</p>
        }
    </section>

    <section class="dashboard-panel staff-records-panel">
        <div class="panel-header">
            <div>
                <span class="panel-eyebrow">ASSIGNED CLIENT PLANS</span>
                <h2>Plans you created</h2>
                <p>Clients can view their plans but cannot change them.</p>
            </div>
        </div>

        @if (actionPlans.Count == 0)
        {
            <div class="empty-state">
                <h3>No action plans yet</h3>
                <p>Plans you create for assigned clients will appear here.</p>
            </div>
        }
        else
        {
            <div class="staff-record-list">
                @foreach (var plan in actionPlans)
                {
                    <article class="staff-record-card action-plan-card">
                        <div class="staff-record-heading">
                            <div>
                                <span class="panel-eyebrow">@plan.Client?.FullName</span>
                                <h3>@plan.Title</h3>
                            </div>
                            <span class="status-badge @(plan.Status == ActionPlanStatus.Completed ? "status-completed" : "status-pending")">
                                @plan.Status
                            </span>
                        </div>
                        <p>@plan.Description</p>
                        <div class="action-plan-meta">
                            <span>Created @plan.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                            @if (plan.TargetDate.HasValue)
                            {
                                <span>Target @plan.TargetDate.Value.ToLocalTime().ToString("MMM d, yyyy")</span>
                            }
                        </div>
                        @if (plan.Status == ActionPlanStatus.Active)
                        {
                            <button class="button button-secondary"
                                    type="button"
                                    @onclick="() => CompleteActionPlanAsync(plan.Id)">
                                Mark completed
                            </button>
                        }
                    </article>
                }
            </div>
        }
    </section>
</div>

@code {
    private List<StaffAssignedClient> clients = [];
    private List<ActionPlan> actionPlans = [];
    private ActionPlanForm newPlan = new();
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.User is null)
        {
            return;
        }

        clients = await Wellness.GetStaffClientsAsync(CurrentUser.User.Id);
        actionPlans = await Wellness.GetStaffActionPlansAsync(CurrentUser.User.Id);
    }

    private async Task CreateActionPlanAsync()
    {
        if (CurrentUser.User is null)
        {
            return;
        }

        try
        {
            await Wellness.CreateActionPlanAsync(
                CurrentUser.User.Id,
                newPlan.ClientId,
                newPlan.Title,
                newPlan.Description,
                newPlan.TargetDate);

            actionPlans = await Wellness.GetStaffActionPlansAsync(
                CurrentUser.User.Id);
            newPlan = new ActionPlanForm();
            statusMessage = "Action plan created. The client can view it and has been notified.";
        }
        catch (InvalidOperationException exception)
        {
            statusMessage = exception.Message;
        }
    }

    private async Task CompleteActionPlanAsync(int actionPlanId)
    {
        if (CurrentUser.User is null)
        {
            return;
        }

        try
        {
            await Wellness.CompleteStaffActionPlanAsync(
                CurrentUser.User.Id,
                actionPlanId);
            actionPlans = await Wellness.GetStaffActionPlansAsync(
                CurrentUser.User.Id);
            statusMessage = "Action plan marked as completed.";
        }
        catch (InvalidOperationException exception)
        {
            statusMessage = exception.Message;
        }
    }

    private sealed class ActionPlanForm
    {
        public int ClientId { get; set; }

        [Required]
        [StringLength(160)]
        public string Title { get; set; } = "";

        [Required]
        [StringLength(2000)]
        public string Description { get; set; } = "";

        public DateTime? TargetDate { get; set; }
    }
}
