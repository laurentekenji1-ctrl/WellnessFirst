@page "/reset-password"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject AccountEmailService AccountEmail
@inject NavigationManager Navigation

<PageTitle>Reset Password | Wellness Platform</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <span class="eyebrow">ACCOUNT RECOVERY</span>
            <h1>Choose a new password</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert" role="alert">@errorMessage</div>
        }

        @if (hasResetToken)
        {
            <EditForm Model="model" OnValidSubmit="ResetPasswordAsync">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label for="password">New password</label>
                    <InputText id="password"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               @bind-Value="model.Password" />
                    <ValidationMessage For="@(() => model.Password)" />
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm password</label>
                    <InputText id="confirmPassword"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               @bind-Value="model.ConfirmPassword" />
                    <ValidationMessage For="@(() => model.ConfirmPassword)" />
                </div>
                <button class="button button-primary" type="submit" disabled="@loading">
                    Reset password
                </button>
            </EditForm>
        }

        <div class="auth-footer">
            <a href="/forgot-password">Request another reset link</a>
            <a href="/signin">Back to sign in</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordModel model = new();
    private bool loading;
    private bool hasResetToken => !string.IsNullOrWhiteSpace(UserId) &&
        !string.IsNullOrWhiteSpace(Token);
    private string? errorMessage;

    private async Task ResetPasswordAsync()
    {
        if (!hasResetToken)
        {
            errorMessage = "This reset link is invalid or has expired.";
            return;
        }

        loading = true;
        errorMessage = null;
        try
        {
            var result = await AccountEmail.ResetPasswordAsync(
                UserId!,
                Token!,
                model.Password);
            if (result.Succeeded)
            {
                Navigation.NavigateTo("/signin?reset=success");
                return;
            }

            errorMessage = string.Join(
                " ",
                result.Errors.Select(error => error.Description));
        }
        finally
        {
            loading = false;
        }
    }

    private sealed class ResetPasswordModel
    {
        [Required]
        [MinLength(8)]
        public string Password { get; set; } = "";

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
