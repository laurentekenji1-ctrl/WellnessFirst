@page "/staff/change-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using WellnessPlatform.Models

@attribute [Authorize(Roles = "Staff")]

@inject UserManager<AppUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Change Password - Wellness First</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h3 class="mb-2">Change Password</h3>
                    <p class="text-muted mb-4">
                        Update your account password to keep your account secure.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            @SuccessMessage
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @ErrorMessage
                        </div>
                    }

                    <EditForm Model="Input" OnValidSubmit="ChangePasswordAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Current Password</label>
                            <InputText type="password"
                                       class="form-control"
                                       @bind-Value="Input.CurrentPassword"
                                       autocomplete="current-password" />
                            <ValidationMessage For="@(() => Input.CurrentPassword)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <InputText type="password"
                                       class="form-control"
                                       @bind-Value="Input.NewPassword"
                                       autocomplete="new-password" />
                            <ValidationMessage For="@(() => Input.NewPassword)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirm New Password</label>
                            <InputText type="password"
                                       class="form-control"
                                       @bind-Value="Input.ConfirmPassword"
                                       autocomplete="new-password" />
                            <ValidationMessage For="@(() => Input.ConfirmPassword)" />
                        </div>

                        <div class="text-muted small mb-3">
                            Your new password must be at least 8 characters and include
                            uppercase, lowercase, a number, and a special character.
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100"
                                disabled="@IsSaving">
                            @if (IsSaving)
                            {
                                <span>Updating Password...</span>
                            }
                            else
                            {
                                <span>Update Password</span>
                            }
                        </button>
                    </EditForm>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private PasswordChangeInput Input = new();
    private bool IsSaving;
    private string? SuccessMessage;
    private string? ErrorMessage;

    private async Task ChangePasswordAsync()
    {
        if (IsSaving)
            return;

        IsSaving = true;
        SuccessMessage = null;
        ErrorMessage = null;

        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = await UserManager.GetUserAsync(authState.User);

            if (user is null || user.Role != UserRole.Staff || !user.Active)
            {
                ErrorMessage = "Your staff account could not be verified.";
                return;
            }

            if (Input.NewPassword != Input.ConfirmPassword)
            {
                ErrorMessage = "The new password and confirmation do not match.";
                return;
            }

            if (Input.CurrentPassword == Input.NewPassword)
            {
                ErrorMessage = "Your new password must be different from your current password.";
                return;
            }

            var result = await UserManager.ChangePasswordAsync(
                user,
                Input.CurrentPassword,
                Input.NewPassword);

            if (!result.Succeeded)
            {
                ErrorMessage = string.Join(" ",
                    result.Errors.Select(error => error.Description));

                return;
            }

            SuccessMessage = "Your password has been changed successfully.";

            Input = new PasswordChangeInput();
        }
        catch
        {
            ErrorMessage = "We could not update your password. Please try again.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private sealed class PasswordChangeInput
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your new password.")]
        [MinLength(8, ErrorMessage = "Your new password must contain at least 8 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}